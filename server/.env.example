# ============================================
# Configurações do Backend - Controle de Finanças
# ============================================
# Copie este arquivo para .env e preencha os valores

# URL de conexão com o PostgreSQL (Railway)
# Exemplo: postgresql://user:password@host:5432/database
DATABASE_URL=sua_url_do_railway_aqui

# Porta do servidor backend
PORT=5000

# URL do frontend (para CORS)
# Em desenvolvimento: http://localhost:3000
# Em produção: URL do Vercel
FRONTEND_URL=http://localhost:3000

# API Key do Groq (gratuito - console.groq.com)
GROQ_API_KEY=sua_chave_aqui

# Chave secreta para JWT (obrigatório)
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua_chave_secreta_aqui

# ============================================
# Configurações do Open Finance (Pluggy API)
# ============================================
# Obtenha em: https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=seu_client_id_pluggy
PLUGGY_CLIENT_SECRET=seu_client_secret_pluggy
PLUGGY_API_URL=https://api.pluggy.ai
