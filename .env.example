# ============================================
# Configurações do Frontend - Controle de Finanças
# ============================================
# Copie este arquivo para .env e preencha os valores

# Porta do servidor de desenvolvimento
PORT=3000

# Client ID do Google OAuth para autenticação
# Obtenha em: https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_CLIENT_ID=seu_client_id_aqui

# URL da API backend (Railway)
# Em desenvolvimento: http://localhost:5000/api
# Em produção: URL do Railway
REACT_APP_API_URL=http://localhost:5000/api
