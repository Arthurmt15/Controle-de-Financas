# ============================================
# Configurações do Frontend - Controle de Finanças
# Backend 100% Supabase (Railway removido)
# ============================================

# Porta do servidor de desenvolvimento
PORT=3000

# Client ID do Google OAuth
# Obtenha em: https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_CLIENT_ID=seu_client_id_aqui

# Supabase
# Obtenha em: https://supabase.com/dashboard → Settings → API
REACT_APP_SUPABASE_URL=sua_url_do_supabase_aqui
REACT_APP_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Flag para ativar/desativar integração Supabase
REACT_APP_USE_SUPABASE=true

# URL da API backend (se houver; senão deixe vazio para usar Supabase direto)
# REACT_APP_API_URL=http://localhost:5000/api

# ============================================
# Configurações do Backend (server/.env)
# Copie para server/.env quando usar backend Express
# ============================================
# DATABASE_URL=postgresql://postgres:[SENHA]@db.seu-projeto.supabase.co:5432/postgres
# JWT_SECRET=gere_com_openssl_rand_hex_32
# FRONTEND_URL=http://localhost:3000
# GROQ_API_KEY=sua_chave_groq_aqui
# NODE_ENV=development
#
# OBRIGATÓRIO: audience do Google ID token (mesmo client ID usado no frontend).
# Sem isso o backend recusa qualquer login.
# GOOGLE_CLIENT_ID=seu_client_id_aqui
#
# TLS do Postgres: por padrão o certificado é verificado.
# Para usar um CA próprio (recomendado), informe o PEM:
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Último recurso (inseguro, sujeito a MITM): desabilita a verificação.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
#
# Habilite apenas se o backend estiver atrás de um proxy reverso confiável
# (ex.: 1 para um proxy). Sem isso, o rate limit usa o IP direto da conexão.
# TRUST_PROXY=1

# Segredos da Edge Function (configure com `supabase secrets set`, nunca no frontend)
# PLUGGY_CLIENT_ID=seu_client_id_pluggy
# PLUGGY_CLIENT_SECRET=seu_client_secret_pluggy
# Origem(ns) permitida(s) no CORS das functions, separadas por vírgula.
# Sem isso, as Edge Functions bloqueiam chamadas cross-origin.
# SUPABASE_CORS_ORIGIN=https://seu-app.vercel.app,http://localhost:3000
